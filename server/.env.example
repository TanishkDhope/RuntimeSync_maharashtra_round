# --- Diagnoser -------------------------------------------------------------
# stub   = no ML, matches the student's output against problems.jsonl
# model  = loads fine-tuned sentence-transformers model from MODEL_PATH (or GGUF via Ollama)
# ollama = uses GGUF file / Ollama embedding model (relearn-diagnosis)
DIAGNOSER=ollama
MODEL_PATH=../model/relearn-diagnosis.gguf
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=relearn-diagnosis


# Prompts passed to the embedding model. Empty for most models.
# EmbeddingGemma: QUERY_PROMPT="task: classification | query: "  DOC_PROMPT="title: none | text: "
QUERY_PROMPT=
DOC_PROMPT=

# --- Thresholds (retune once the real model exists) ------------------------
UNKNOWN_THRESHOLD=0.5
# Read by the probe path, which is not built yet.
PROBE_GAP=0.1

# --- Quiz ------------------------------------------------------------------
SESSION_LENGTH=5
RUN_TIMEOUT_SECONDS=5

# --- Paths -----------------------------------------------------------------
DATA_DIR=../data

# --- Database --------------------------------------------------------------
# Supabase is plain Postgres. In the Supabase dashboard: Connect -> ORMs/
# SQLAlchemy, or Project Settings -> Database -> Connection string, then paste
# it below and replace [YOUR-PASSWORD] with your database password.
# Prefer the Session pooler (port 5432 on *.pooler.supabase.com); the
# Transaction pooler (port 6543) also works and is handled automatically.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Local fallback, used when the line above is commented out:
DATABASE_URL=
SUPABASE_URL=

# --- Frontend origin -------------------------------------------------------
# Vite falls back to 5174/5175 when 5173 is already in use.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# --- LLM (not used yet; the intervention and probe paths are not built) ----
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
