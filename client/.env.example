# Where the FastAPI backend is listening. Defaults to http://localhost:8000.
VITE_API_BASE=http://localhost:8000

# Development only: run the whole app against built-in sample steps instead of
# the backend, so screens the backend does not serve yet can be built and
# reviewed. Every screen shows a "SAMPLE DATA" banner while this is on, and the
# production build never includes it (npm run build checks).
# VITE_SAMPLE_STEPS=1
